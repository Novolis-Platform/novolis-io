<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <!-- Repo default TargetFramework is net10.0; this package also targets Android. -->
    <TargetFramework></TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23</SupportedOSPlatformVersion>
    <PackageId>Novolis.IO.Platform.Android</PackageId>
    <Description>On-device Android app storage. Defaults to Documents/Novolis/{product} when scoped storage allows a normal directory there, otherwise app-specific external files.</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.IO.Platform.Android</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
